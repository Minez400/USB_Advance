<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requisito de Hardware USB Host para operação direta sem root -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Permissões de Foreground Service para Android 14 (API 34) e Android 15 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Prevenção de suspensão de CPU durante gravações longas -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notificações em segundo plano para Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".UsbAdvanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@null"
        android:fullBackupContent="@null"
        android:icon="@android:drawable/stat_sys_data_bluetooth"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/stat_sys_data_bluetooth"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intercepta evento de conexão física do pendrive USB OTG -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Serviço em primeiro plano resistente a Low Memory Killer -->
        <service
            android:name="org.usbadvance.feature.formatter.service.FormatForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

    </application>

</manifest>
