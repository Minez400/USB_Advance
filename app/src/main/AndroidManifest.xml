<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB Host Hardware Feature required for direct userspace access without root -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Foreground Service permissions for Android 14 (API 34) and Android 15 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- CPU WakeLock prevention during lengthy write operations -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Background notifications for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".UsbAdvanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@null"
        android:fullBackupContent="@null"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UsbAdvance"
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intercept physical USB OTG mass storage connection event -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Low Memory Killer resistant foreground service -->
        <service
            android:name="org.usbadvance.feature.formatter.service.FormatForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

    </application>

</manifest>
